gems:col_greenfeedanimalcrosswalk_studyId a owl:DatatypeProperty ;
    rdfs:label "study identifier"@en ;
    rdfs:domain gems:GreenFeedVisit ;
    rdfs:range xsd:string ;
    gems:fromTable "greenfeedanimalcrosswalk" ;
    gems:fromColumn "studyId" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "Local accession (e.g. 009) for a GEMS Study. The Study class is OBI investigation; this column is only the ID string, not the investigation itself."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_greenfeedanimalcrosswalk_Farm_Name a owl:DatatypeProperty ;
    rdfs:label "GreenFeed Farm_Name (intended AnimalIdentifier)"@en ;
    rdfs:domain gems:GreenFeedVisit ;
    rdfs:range xsd:string ;
    gems:fromTable "greenfeedanimalcrosswalk" ;
    gems:fromColumn "Farm_Name" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "As recorded on the visit. Keep the raw string; the match result is canonicalAnimalIdentifier."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_greenfeedanimalcrosswalk_RFID a owl:DatatypeProperty ;
    rdfs:label "GreenFeed recorded RFID"@en ;
    rdfs:domain gems:GreenFeedVisit ;
    rdfs:range xsd:string ;
    gems:fromTable "greenfeedanimalcrosswalk" ;
    gems:fromColumn "RFID" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "Visit RFID; part of the visit key with studyId and Start_Time."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_greenfeedanimalcrosswalk_Start_Time a owl:DatatypeProperty ;
    rdfs:label "visit start timestamp"@en ;
    rdfs:domain gems:GreenFeedVisit ;
    rdfs:range xsd:dateTime ;
    gems:fromTable "greenfeedanimalcrosswalk" ;
    gems:fromColumn "Start_Time" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "GreenFeed visit start; part of the visit key."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_greenfeedanimalcrosswalk_canonicalAnimalIdentifier a owl:DatatypeProperty ;
    rdfs:label "canonical study animal identifier"@en ;
    rdfs:domain gems:GreenFeedVisit ;
    rdfs:range xsd:string ;
    gems:fromTable "greenfeedanimalcrosswalk" ;
    gems:fromColumn "canonicalAnimalIdentifier" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "Resolved AnimalIdentifier for the visit (same studyId). Join milk, intake, body weight, digestibility, or design on this, not raw Farm_Name. Empty when matchOk is false."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_greenfeedanimalcrosswalk_matchMethod a owl:DatatypeProperty ;
    rdfs:label "GreenFeed ID match method"@en ;
    rdfs:domain gems:GreenFeedVisit ;
    rdfs:range xsd:string ;
    gems:fromTable "greenfeedanimalcrosswalk" ;
    gems:fromColumn "matchMethod" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "How the visit was linked: exact (Farm_Name or RFID equals the workbook ID), sequence (the workbook ID is inside Farm_Name or RFID), rfidEnd (the visit RFID is the end of the workbook RFID, e.g. a replacement tag), ambiguous (two animals tie, not linked), unmatched."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_greenfeedanimalcrosswalk_matchOk a owl:DatatypeProperty ;
    rdfs:label "GreenFeed animal match succeeded"@en ;
    rdfs:domain gems:GreenFeedVisit ;
    rdfs:range xsd:boolean ;
    gems:fromTable "greenfeedanimalcrosswalk" ;
    gems:fromColumn "matchOk" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "true when canonicalAnimalIdentifier is set. Unmatched visits are kept."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_greenfeedanimalcrosswalk_inDesignWindow a owl:DatatypeProperty ;
    rdfs:label "visit within experimental design window"@en ;
    rdfs:domain gems:GreenFeedVisit ;
    rdfs:range xsd:boolean ;
    gems:fromTable "greenfeedanimalcrosswalk" ;
    gems:fromColumn "inDesignWindow" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "True when the visit date falls inside the study's experimental design dates."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .
