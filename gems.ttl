@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix atol: <http://opendata.inra.fr/ATOL/> .
@prefix lho:  <http://www.purl.org/decide/LiveStockHealthOnto/LHO#> .
@prefix gems: <https://w3id.org/gems/ontology#> .

# GEMS ontology: what the tables of the GEMS GreenFeed database mean.
# Classes are the kinds of record (study, animal, diet, GreenFeed visit, milk, intake, ...), datatype properties
# are the columns, and object properties are the links between records. Columns are mapped to public ontology
# terms (LHO, ATOL, ChEBI, PATO, CMO, FoodOn, ENVO, OBI, TO, LBO, NCIT) with skos:exactMatch / skos:closeMatch
# where a match exists; the rest are GEMS-only terms.
# Data records use IDs under https://w3id.org/gems/id/. This file holds no animal data.

<https://w3id.org/gems/ontology>
    a owl:Ontology ;
    dct:title "GEMS GreenFeed Emissions Measurement System ontology"@en ;
    dct:description "Classes, properties and links for the GEMS database of enteric methane measurements made with GreenFeed systems, with the animal, diet, intake and milk records collected alongside them. Columns are mapped to public ontology terms where a match exists."@en ;
    dct:creator "Puchun Niu" ,
        "Hanlu Zhang" ,
        "Miel Hostens" ;
    dct:bibliographicCitation "Niu P, Zhang H, Hostens M. GEMS ontology, version 0.2.1. https://w3id.org/gems/ontology" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:issued "2026-11-11"^^xsd:date ;
    owl:versionIRI <https://w3id.org/gems/ontology/0.2.1> ;
    owl:versionInfo "0.2.1" ;
    vann:preferredNamespacePrefix "gems" ;
    vann:preferredNamespaceUri "https://w3id.org/gems/ontology#" .

#################################################################
# Annotation properties
#################################################################

gems:fromTable a owl:AnnotationProperty ;
    rdfs:label "from table"@en ;
    rdfs:comment "Name of the GEMS table the column belongs to (lowercase, no spaces)."@en .

gems:fromColumn a owl:AnnotationProperty ;
    rdfs:label "from column"@en .

gems:matchType a owl:AnnotationProperty ;
    rdfs:label "match type"@en ;
    rdfs:comment "exact | close | GEMS-only | lookup_ATOL, from the column map."@en .

gems:unit a owl:AnnotationProperty ;
    rdfs:label "unit"@en ;
    rdfs:comment "Unit of the values, as recorded with the data or in the column name (e.g. kg, g/d, %)."@en .

gems:hasAnalyte a owl:AnnotationProperty ;
    rdfs:label "has analyte"@en ;
    rdfs:comment "Chemical entity being measured (ChEBI). Used with gas mass-flow columns."@en .

gems:hasQuality a owl:AnnotationProperty ;
    rdfs:label "has quality"@en ;
    rdfs:comment "PATO quality of the measurement (e.g. mass flow rate, temperature)."@en .

gems:hasTrait a owl:AnnotationProperty ;
    rdfs:label "has trait"@en ;
    rdfs:comment "Livestock or clinical measurement class (ATOL/CMO) for the phenotype."@en .

#################################################################
# Core classes
#################################################################

gems:Study a owl:Class ;
    rdfs:label "study"@en ;
    rdfs:comment "A GEMS trial (the thing). This class is a kind of OBI investigation. The spreadsheet column studyId is only the local code for this Study, not the investigation class."@en ;
    rdfs:subClassOf obo:OBI_0000066 .

gems:Animal a owl:Class ;
    rdfs:label "study animal"@en ;
    rdfs:comment "An animal in a GEMS study, keyed by studyId + AnimalIdentifier."@en .

gems:Treatment a owl:Class ;
    rdfs:label "experimental treatment"@en ;
    rdfs:comment "GEMS treatment code/name within one study. Not ENVO animal feed."@en .

gems:Diet a owl:Class ;
    rdfs:label "offered diet"@en ;
    rdfs:comment "Ration fed under one treatment of a study."@en .

gems:DietComponent a owl:Class ;
    rdfs:label "diet ingredient"@en ;
    rdfs:subClassOf obo:FOODON_00002403 ;
    rdfs:comment "One ingredient of a treatment diet, with its proportion and nutrient content."@en .

gems:DietNutrientRecord a owl:Class ;
    rdfs:label "diet nutrient composition"@en ;
    rdfs:comment "Nutrient composition of a treatment diet on a date."@en .

gems:BaitPellet a owl:Class ;
    rdfs:label "GreenFeed bait pellet"@en ;
    rdfs:comment "Bait, not the offered diet. Same nutrient analytes as diet, different sample. One per study."@en .

gems:BaitPelletComponent a owl:Class ;
    rdfs:label "bait pellet ingredient"@en ;
    rdfs:subClassOf obo:FOODON_00002403 ;
    rdfs:comment "One ingredient of the GreenFeed bait pellet."@en .

gems:Observation a owl:Class ;
    rdfs:label "observation"@en ;
    rdfs:subClassOf <http://www.purl.org/decide#Measurement> ;
    rdfs:comment "A measurement row: study + animal + time + variables. A kind of LHO Measurement."@en .

gems:AnimalDayObservation a owl:Class ;
    rdfs:label "animal-day observation"@en ;
    rdfs:subClassOf gems:Observation ;
    rdfs:comment "A measurement on one animal on one date (studyId + AnimalIdentifier + Date)."@en .

gems:MilkObservation a owl:Class ;
    rdfs:label "milk observation"@en ;
    rdfs:subClassOf gems:AnimalDayObservation ;
    rdfs:comment "Milk yield and composition of one animal on one date, or one milking when MilkingTime is given."@en .

gems:BodyWeightObservation a owl:Class ;
    rdfs:label "body weight observation"@en ;
    rdfs:subClassOf gems:AnimalDayObservation ;
    rdfs:comment "Body weight of one animal on one date."@en .

gems:IntakeDayObservation a owl:Class ;
    rdfs:label "daily intake observation"@en ;
    rdfs:subClassOf gems:AnimalDayObservation ;
    rdfs:comment "Feed and water intake of one animal on one date."@en .

gems:DigestibilityObservation a owl:Class ;
    rdfs:label "digestibility observation"@en ;
    rdfs:subClassOf gems:AnimalDayObservation ;
    rdfs:comment "Apparent digestibility and fecal/urine output of one animal for a collection date."@en .

gems:IntakeEvent a owl:Class ;
    rdfs:label "feeding event"@en ;
    rdfs:subClassOf gems:Observation ;
    rdfs:comment "One feeding event of one animal."@en .

gems:GreenFeedVisit a owl:Class ;
    rdfs:label "GreenFeed visit"@en ;
    rdfs:subClassOf gems:Observation ;
    rdfs:comment "One visit of an animal to a GreenFeed unit, identified by studyId + RFID + Start_Time. Linked to an animal only when matchOk is true; the link uses canonicalAnimalIdentifier, never the raw Farm_Name. Do not owl:sameAs raw strings."@en .

gems:ChamberObservation a owl:Class ;
    rdfs:label "respiration chamber observation"@en ;
    rdfs:subClassOf gems:Observation ;
    rdfs:comment "One respiration chamber reading of one animal at a time of day."@en .

gems:DesignRecord a owl:Class ;
    rdfs:label "experimental design record"@en ;
    rdfs:comment "Experimental design of one animal on one date: treatment, period, phase, housing and feeding."@en .

gems:Instrument a owl:Class ;
    rdfs:label "instrument"@en ;
    rdfs:comment "GreenFeed unit or respiration chamber."@en .

gems:GreenFeedUnit a owl:Class ;
    rdfs:label "GreenFeed unit"@en ;
    rdfs:subClassOf gems:Instrument ;
    rdfs:comment "One GreenFeed unit used in a study, with its settings."@en .

gems:RespirationChamber a owl:Class ;
    rdfs:label "respiration chamber"@en ;
    rdfs:subClassOf gems:Instrument ;
    rdfs:comment "One respiration chamber used in a study."@en .

gems:ChamberCalibration a owl:Class ;
    rdfs:label "respiration chamber recovery test"@en ;
    rdfs:comment "Gas recovery test of one respiration chamber on one date."@en .

# Reused public classes. The IRI stays as published; Protégé shows rdfs:label, not the ID string.
obo:OBI_0000066 a owl:Class ;
    rdfs:label "investigation"@en ;
    rdfs:comment "OBI investigation. gems:Study is a subclass. Do not rename the IRI."@en .

obo:FOODON_00002403 a owl:Class ;
    rdfs:label "feed ingredient"@en ;
    rdfs:comment "FoodOn class food material (FOODON_00002403). Shown here as feed ingredient."@en .

<http://www.purl.org/decide#Measurement> a owl:Class ;
    rdfs:label "measurement"@en ;
    rdfs:comment "LHO (Livestock Health Ontology V1.5) Measurement class. gems:Observation is a subclass. Do not rename the IRI."@en .

#################################################################
# Links between nodes (GEMS-local object properties)
#################################################################

gems:belongsToStudy a owl:ObjectProperty ;
    rdfs:label "belongs to study"@en ;
    rdfs:range gems:Study .

gems:aboutAnimal a owl:ObjectProperty ;
    rdfs:label "about animal"@en ;
    rdfs:range gems:Animal ;
    rdfs:comment "The animal a record is about. Rows link by studyId + AnimalIdentifier; GreenFeed visits by studyId + canonicalAnimalIdentifier, and only when matchOk is true."@en .

gems:receivesTreatment a owl:ObjectProperty ;
    rdfs:label "receives treatment"@en ;
    rdfs:range gems:Treatment ;
    rdfs:comment "Treatment the animal received on the date of this record (design or digestibility record). On the cow-day, not the animal, because animals can change treatment between periods."@en .

gems:usesDiet a owl:ObjectProperty ;
    rdfs:label "uses diet"@en ;
    rdfs:domain gems:Treatment ;
    rdfs:range gems:Diet .

gems:hasIngredient a owl:ObjectProperty ;
    rdfs:label "has ingredient"@en ;
    rdfs:range obo:FOODON_00002403 ;
    rdfs:comment "A diet or bait pellet and one of its ingredient lines."@en .

gems:aboutDiet a owl:ObjectProperty ;
    rdfs:label "about diet"@en ;
    rdfs:domain gems:DietNutrientRecord ;
    rdfs:range gems:Diet .

gems:recordedBy a owl:ObjectProperty ;
    rdfs:label "recorded by"@en ;
    rdfs:range gems:Instrument ;
    rdfs:comment "Instrument that recorded an observation (GreenFeed unit through FID, chamber through ChamberIdentification)."@en .

gems:aboutInstrument a owl:ObjectProperty ;
    rdfs:label "about instrument"@en ;
    rdfs:domain gems:ChamberCalibration ;
    rdfs:range gems:Instrument .

#################################################################
# Identifier properties of core nodes (GEMS-local)
#################################################################

gems:studyId a owl:DatatypeProperty ;
    rdfs:label "studyId"@en ;
    rdfs:domain gems:Study ;
    rdfs:range xsd:string ;
    rdfs:comment "Local accession string (e.g. 009). Identifies a Study. Not OBI investigation — that class is gems:Study."@en .

gems:isOpenData a owl:DatatypeProperty ;
    rdfs:label "is open data"@en ;
    rdfs:domain gems:Study ;
    rdfs:range xsd:boolean ;
    rdfs:comment "True when the study's contributor agreed to open release."@en .

gems:animalIdentifier a owl:DatatypeProperty ;
    rdfs:label "AnimalIdentifier"@en ;
    rdfs:domain gems:Animal ;
    rdfs:range xsd:string ;
    rdfs:comment "Study animal ID. Unique only together with studyId."@en .

# Identifier matching is data hygiene on the GreenFeed animal crosswalk, always inside one studyId.
# Do not rewrite Farm_Name on the GreenFeed visit table. A reasoner will not infer padded IDs.

#################################################################
# Column properties (generated from column_term_map.xlsx and table_map.xlsx)
#################################################################


gems:col_animalcharacteristics_studyId a owl:DatatypeProperty ;
    rdfs:label "study identifier"@en ;
    rdfs:domain gems:Animal ;
    rdfs:range xsd:string ;
    gems:fromTable "animalcharacteristics" ;
    gems:fromColumn "studyId" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "Local accession (e.g. 009) for a GEMS Study. The Study class is OBI investigation; this column is only the ID string, not the investigation itself."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_animalcharacteristics_AnimalIdentifier a owl:DatatypeProperty ;
    rdfs:label "study animal identifier"@en ;
    rdfs:domain gems:Animal ;
    rdfs:range xsd:string ;
    gems:fromTable "animalcharacteristics" ;
    gems:fromColumn "AnimalIdentifier" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "Local barn/study ID. Join with studyId. Not ATOL."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_animalcharacteristics_RadioFrequencyIdentification a owl:DatatypeProperty ;
    rdfs:label "animal RFID / EID"@en ;
    rdfs:domain gems:Animal ;
    rdfs:range xsd:string ;
    gems:fromTable "animalcharacteristics" ;
    gems:fromColumn "RadioFrequencyIdentification" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "Optional tag on characteristics. Variants: 984…, padded zeros, GF_short."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_animalcharacteristics_Breed a owl:DatatypeProperty ;
    rdfs:label "breed"@en ;
    rdfs:domain gems:Animal ;
    rdfs:range xsd:string ;
    gems:fromTable "animalcharacteristics" ;
    gems:fromColumn "Breed" ;
    gems:matchType "close" ;
    rdfs:comment "LBO root class 'breed'. Map each breed value to a child (Holstein, Angus, ...) later. NCBITaxon is species, not breed."@en ;
    skos:closeMatch obo:LBO_0000000 .

gems:col_animalcharacteristics_ProductionType a owl:DatatypeProperty ;
    rdfs:label "production type (dairy/beef/…)"@en ;
    rdfs:domain gems:Animal ;
    rdfs:range xsd:string ;
    gems:fromTable "animalcharacteristics" ;
    gems:fromColumn "ProductionType" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "Search ATOL/EOL for dairy vs beef production context."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_animalcharacteristics_AnimalType a owl:DatatypeProperty ;
    rdfs:label "animal type / species"@en ;
    rdfs:domain gems:Animal ;
    rdfs:range xsd:string ;
    gems:fromTable "animalcharacteristics" ;
    gems:fromColumn "AnimalType" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "Keep GEMS-local: values may be cattle, calf, sheep, goat. Do not pin the column to Bos taurus."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_animalcharacteristics_BirthDate a owl:DatatypeProperty ;
    rdfs:label "BirthEvent"@en ;
    rdfs:domain gems:Animal ;
    rdfs:range xsd:date ;
    gems:fromTable "animalcharacteristics" ;
    gems:fromColumn "BirthDate" ;
    gems:matchType "close" ;
    rdfs:comment "LHO V1.5 BirthEvent; the column is the date of that event, so close. xsd:date."@en ;
    skos:closeMatch lho:BirthEvent .

gems:col_animalcharacteristics_Age a owl:DatatypeProperty ;
    rdfs:label "Age"@en ;
    rdfs:domain gems:Animal ;
    rdfs:range xsd:double ;
    gems:fromTable "animalcharacteristics" ;
    gems:fromColumn "Age" ;
    gems:matchType "exact" ;
    rdfs:comment "LHO V1.5 Age (measurement type). Replaces ATOL age (ATOL_0000088)."@en ;
    skos:exactMatch lho:Age ;
    gems:hasQuality obo:PATO_0000011 .

gems:col_animalcharacteristics_AnimalStatus a owl:DatatypeProperty ;
    rdfs:label "physiological/lactation status"@en ;
    rdfs:domain gems:Animal ;
    rdfs:range xsd:string ;
    gems:fromTable "animalcharacteristics" ;
    gems:fromColumn "AnimalStatus" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "Search ATOL for lactating, dry, pregnant."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_animalcharacteristics_Parity a owl:DatatypeProperty ;
    rdfs:label "parity / number of lactations"@en ;
    rdfs:domain gems:Animal ;
    rdfs:range xsd:integer ;
    gems:fromTable "animalcharacteristics" ;
    gems:fromColumn "Parity" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "Search ATOL for parity."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_animalcharacteristics_DaysInMilk a owl:DatatypeProperty ;
    rdfs:label "stage of lactation"@en ;
    rdfs:domain gems:Animal ;
    rdfs:range xsd:integer ;
    gems:fromTable "animalcharacteristics" ;
    gems:fromColumn "DaysInMilk" ;
    gems:matchType "exact" ;
    rdfs:comment "ATOL stage of lactation; exact synonym DIM / days in milk. CattlePresent in ATOL."@en ;
    skos:exactMatch atol:ATOL_0005297 .

gems:col_animalcharacteristics_Cannulation a owl:DatatypeProperty ;
    rdfs:label "cannulation status"@en ;
    rdfs:domain gems:Animal ;
    rdfs:range xsd:string ;
    gems:fromTable "animalcharacteristics" ;
    gems:fromColumn "Cannulation" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "Surgical/experimental status, not a production trait."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_bodyweight_studyId a owl:DatatypeProperty ;
    rdfs:label "study identifier"@en ;
    rdfs:domain gems:BodyWeightObservation ;
    rdfs:range xsd:string ;
    gems:fromTable "bodyweight" ;
    gems:fromColumn "studyId" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "Local accession (e.g. 009) for a GEMS Study. The Study class is OBI investigation; this column is only the ID string, not the investigation itself."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_bodyweight_AnimalIdentifier a owl:DatatypeProperty ;
    rdfs:label "study animal identifier"@en ;
    rdfs:domain gems:BodyWeightObservation ;
    rdfs:range xsd:string ;
    gems:fromTable "bodyweight" ;
    gems:fromColumn "AnimalIdentifier" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "Local barn/study ID. Join with studyId. Not ATOL."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_bodyweight_Date a owl:DatatypeProperty ;
    rdfs:label "Date"@en ;
    rdfs:domain gems:BodyWeightObservation ;
    rdfs:range xsd:date ;
    gems:fromTable "bodyweight" ;
    gems:fromColumn "Date" ;
    gems:matchType "close" ;
    rdfs:comment "LHO V1.5 Date. Observation day of the animal x day spine; close, not exact. xsd:date."@en ;
    skos:closeMatch lho:Date .

gems:col_bodyweight_BodyWeight a owl:DatatypeProperty ;
    rdfs:label "Weight"@en ;
    rdfs:domain gems:BodyWeightObservation ;
    rdfs:range xsd:double ;
    gems:fromTable "bodyweight" ;
    gems:fromColumn "BodyWeight" ;
    gems:matchType "close" ;
    gems:unit "kg" ;
    rdfs:comment "LHO V1.5 Weight (measurement type). LHO has no body-weight term, so close. The unit is given with the data."@en ;
    skos:closeMatch lho:Weight .

gems:col_dietnutrientcomposition_studyId a owl:DatatypeProperty ;
    rdfs:label "study identifier"@en ;
    rdfs:domain gems:DietNutrientRecord ;
    rdfs:range xsd:string ;
    gems:fromTable "dietnutrientcomposition" ;
    gems:fromColumn "studyId" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "Local accession (e.g. 009) for a GEMS Study. The Study class is OBI investigation; this column is only the ID string, not the investigation itself."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_dietnutrientcomposition_Date a owl:DatatypeProperty ;
    rdfs:label "Date"@en ;
    rdfs:domain gems:DietNutrientRecord ;
    rdfs:range xsd:date ;
    gems:fromTable "dietnutrientcomposition" ;
    gems:fromColumn "Date" ;
    gems:matchType "close" ;
    rdfs:comment "LHO V1.5 Date. Observation day of the animal x day spine; close, not exact. xsd:date."@en ;
    skos:closeMatch lho:Date .

gems:col_dietnutrientcomposition_Treatment a owl:DatatypeProperty ;
    rdfs:label "experimental treatment"@en ;
    rdfs:domain gems:DietNutrientRecord ;
    rdfs:range xsd:string ;
    gems:fromTable "dietnutrientcomposition" ;
    gems:fromColumn "Treatment" ;
    gems:matchType "GEMS-only" ;
    rdfs:comment "GEMS treatment code/name. Links diet and animals. ENVO:02000047 is animal feed — not used."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_dietnutrientcomposition_ProportionForage a owl:DatatypeProperty ;
    rdfs:label "forage proportion of diet"@en ;
    rdfs:domain gems:DietNutrientRecord ;
    rdfs:range xsd:double ;
    gems:fromTable "dietnutrientcomposition" ;
    gems:fromColumn "ProportionForage" ;
    gems:matchType "GEMS-only" ;
    gems:unit "%" ;
    rdfs:comment "Diet structure, not ATOL."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_dietnutrientcomposition_ProportionConcentrate a owl:DatatypeProperty ;
    rdfs:label "concentrate proportion of diet"@en ;
    rdfs:domain gems:DietNutrientRecord ;
    rdfs:range xsd:double ;
    gems:fromTable "dietnutrientcomposition" ;
    gems:fromColumn "ProportionConcentrate" ;
    gems:matchType "GEMS-only" ;
    gems:unit "%" ;
    rdfs:comment "Diet structure, not ATOL."@en ;
    rdfs:isDefinedBy <https://w3id.org/gems/ontology> .

gems:col_dietnutrientcomposition_OrganicMatter a owl:DatatypeProperty ;
    rdfs:label "organic molecular entity"@en ;
    rdfs:domain gems:DietNutrientRecord ;
    rdfs:range xsd:double ;
    gems:fromTable "dietnutrientcomposition" ;
    gems:fromColumn "OrganicMatter" ;
    gems:matchType "close" ;
    gems:unit "g/kg" ;
    rdfs:comment "OM (g/kg) of the offered diet. IRI is the CHEBI chemical class (analyte), not the lab method (Kjeldahl CP, ether extract, OM ashing). Close, not exact: the lab measure (crude protein = N x 6.25, ether extract, OM by ashing) is broader than the CHEBI chemical class."@en ;
    skos:closeMatch obo:CHEBI_50860 .

gems:col_dietnutrientcomposition_CrudeProtein a owl:DatatypeProperty ;
    rdfs:label "protein"@en ;
    rdfs:domain gems:DietNutrientRecord ;
    rdfs:range xsd:double ;
    gems:fromTable "dietnutrientcomposition" ;
    gems:fromColumn "CrudeProtein" ;
    gems:matchType "close" ;
    gems:unit "g/kg" ;
    rdfs:comment "Crude protein of the offered diet. IRI is the CHEBI chemical class (analyte), not the lab method (Kjeldahl CP, ether extract, OM ashing). Close, not exact: the lab measure (crude protein = N x 6.25, ether extract, OM by ashing) is broader than the CHEBI chemical class."@en ;
    skos:closeMatch obo:CHEBI_36080 .

gems:col_dietnutrientcomposition_EtherExtract a owl:DatatypeProperty ;
    rdfs:label "lipid"@en ;
    rdfs:domain gems:DietNutrientRecord ;
    rdfs:range xsd:double ;
    gems:fromTable "dietnutrientcomposition" ;
    gems:fromColumn "EtherExtract" ;
    gems:matchType "close" ;
    gems:unit "g/kg" ;
    rdfs:comment "Ether extract / fat of the offered diet. IRI is the CHEBI chemical class (analyte), not the lab method (Kjeldahl CP, ether extract, OM ashing). Close, not exact: the lab measure (crude protein = N x 6.25, ether extract, OM by ashing) is broader than the CHEBI chemical class."@en ;
    skos:closeMatch obo:CHEBI_18059 .

gems:col_dietnutrientcomposition_NeutralDetergentFiber a owl:DatatypeProperty ;
    rdfs:label "neutral detergent fiber content"@en ;
    rdfs:domain gems:DietNutrientRecord ;
    rdfs:range xsd:double ;
    gems:fromTable "dietnutrientcomposition" ;
    gems:fromColumn "NeutralDetergentFiber" ;
    gems:matchType "exact" ;
    gems:unit "g/kg" ;
    rdfs:comment "NDF of the offered diet. Plant Trait Ontology class for this Van Soest lab fraction in plant/feed material. Not an ATOL animal trait. Same analyte mapping as diet and pellet."@en ;
    skos:exactMatch obo:TO_0001148 .

gems:col_dietnutrientcomposition_AcidDetergentFiber a owl:DatatypeProperty ;
    rdfs:label "acid detergent fiber content"@en ;
    rdfs:domain gems:DietNutrientRecord ;
    rdfs:range xsd:double ;
    gems:fromTable "dietnutrientcomposition" ;
    gems:fromColumn "AcidDetergentFiber" ;
    gems:matchType "exact" ;
    gems:unit "g/kg" ;
    rdfs:comment "ADF of the offered diet. Plant Trait Ontology class for this Van Soest lab fraction in plant/feed material. Not an ATOL animal trait. Same analyte mapping as diet and pellet."@en ;
    skos:exactMatch obo:TO_0002641 .

gems:col_dietnutrientcomposition_Lignin a owl:DatatypeProperty ;
    rdfs:label "lignin"@en ;
    rdfs:domain gems:DietNutrientRecord ;
